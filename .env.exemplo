# Copie este arquivo para .env e preencha. O .env nunca vai para o git.
#
# Credenciais da Pluggy: dashboard.pluggy.ai → Applications → sua aplicação.
# Sem elas, o Fluxo roda no modo demonstração.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Mostra os bancos de teste da Pluggy no widget (para experimentar sem banco real).
PLUGGY_INCLUIR_SANDBOX=0

# Porta local (só 127.0.0.1). Mude se a 8778 estiver ocupada.
PORTA=8778
